# Template only. The real .env exists ONLY on the Huawei server at
# ~/convex-huawei/.env (mode 600) and is gitignored here.
#
# Never commit, paste, or echo the real values.

# ── Deployment identity ───────────────────────────────────────────────────────
# Copy BOTH of these verbatim from the deployment being replaced. The backend
# derives its identity from INSTANCE_SECRET; reusing it together with the same
# INSTANCE_NAME is what lets the existing admin key keep working with no re-auth
# on the app side. Regenerating them invalidates the admin key and every
# CONVEX_DEPLOY_KEY derived from it.
INSTANCE_NAME=railway
INSTANCE_SECRET=<copy verbatim from infra/aws-convex/deploy/.env>
CONVEX_SELF_HOSTED_ADMIN_KEY=<copy verbatim from infra/aws-convex/deploy/.env>

# ── Database ──────────────────────────────────────────────────────────────────
# POSTGRES_URL omits the database name and query params by design -- the backend
# appends the database itself, derived from INSTANCE_NAME (railway -> railway).
# The host MUST be the compose service `postgres`. If this ever names
# kodama.proxy.rlwy.net or any other external host, STOP: that is the live
# production database and this stack would write to it.
POSTGRES_PASSWORD=<generated on the server; 32+ random chars>
POSTGRES_URL=postgresql://convex:<POSTGRES_PASSWORD>@postgres:5432

# ── Origins ───────────────────────────────────────────────────────────────────
# Isolated LAN verification values. For a production cutover these become the
# approved public hostnames (see README, "Public ingress").
CONVEX_CLOUD_ORIGIN=http://10.130.231.5:3210
CONVEX_SITE_ORIGIN=http://10.130.231.5:3211

# ── Backend behaviour ─────────────────────────────────────────────────────────
DISABLE_BEACON=true
# Postgres here is on a private Docker bridge that is not published to the host,
# so TLS to it buys nothing. Note this is NOT the same situation as the AWS
# deployment, where the same flag covers a connection crossing the public
# internet to Railway (finding F-02).
DO_NOT_REQUIRE_SSL=true
RUST_LOG=info
