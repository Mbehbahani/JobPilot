{
	"mcpServers": {
		"svelte": {
			"type": "http",
			"url": "https://mcp.svelte.dev/mcp"
		},
		"convex": {
			"command": "bunx",
			"args": ["-y", "convex@latest", "mcp", "start"]
		},
		"unipile": {
			"url": "https://developer.unipile.com/mcp"
		},
		"playwright": {
			"command": "bunx",
			"args": ["@playwright/mcp@latest"]
		},
		"personal_harness": {
			"type": "stdio",
			"command": "D:\\Harness\\.venv\\Scripts\\python.exe",
			"args": ["-m", "personal_harness", "mcp"],
			"env": {
				"HARNESS_DATA_DIR": "C:\\Users\\PC\\AppData\\Local\\PersonalHarness"
			}
		}
	}
}
